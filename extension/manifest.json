{
  "manifest_version": 3,
  "name": "Baixatudo · Referências",
  "version": "0.3.0",
  "description": "Prepare referências por aba, URL ou arquivo autorizado e continue a reconstrução no Studio.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Preparar referência para o Studio"
  },
  "icons": {
    "128": "icon.png"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
