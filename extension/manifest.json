{
  "manifest_version": 3,
  "name": "Baixatudo \u00b7 Refer\u00eancias",
  "version": "0.3.1",
  "description": "Prepare refer\u00eancias por aba, URL ou arquivo autorizado e continue a reconstru\u00e7\u00e3o no Studio.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Preparar refer\u00eancia para o Studio"
  },
  "icons": {
    "128": "icon.png"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
