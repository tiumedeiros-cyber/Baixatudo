# JK Prospect X1 — copie este arquivo para `.env.local` e preencha.
# O `.env.local` nunca vai para o git. Nenhuma chave deste projeto é paga por padrão.

# ── Banco e login (Supabase) ─────────────────────────────────────────────────
# Sem estas duas variáveis o painel abre em MODO DEMONSTRAÇÃO: dados fictícios
# em memória e SEM login. Isso só existe em desenvolvimento (`npm run dev`).
# Em produção (`npm start`), sem elas, o painel recusa tudo.
SUPABASE_URL=
# Chave "publishable" (antiga "anon"), a pública. NUNCA coloque a secret/service_role aqui.
SUPABASE_PUBLISHABLE_KEY=

# E-mail do dono. Só ele entra no painel.
OWNER_EMAIL=

# Assina o cookie do acesso de 1 clique "Entrar neste computador" (mín. 32 caracteres). Esse acesso só
# vale abrindo o painel por localhost; por qualquer outro endereço o painel pede e-mail e senha do
# Supabase. Sem este valor o 1 clique não aparece. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# (opcional) Endereço público do painel, usado no link do e-mail de login e nos links das
# prévias de site enviados aos leads (docs/PREVIAS.md). Se vazio, o painel usa o endereço pelo
# qual você o acessa, que em desenvolvimento é localhost e NÃO abre para o lead.
# SITE_URL=https://seu-endereco-publico

# ── Busca no Google Maps (Apify) ─────────────────────────────────────────────
# Token do Apify (apify.com → Settings → API & integrations).
# Sem ele, o Caçador só aceita importação de JSON (ou gera leads fictícios no modo demonstração).
APIFY_TOKEN=

# ── Envio por WhatsApp (só no seu PC; passo a passo em docs/WHATSAPP.md) ─────
# Sem GOWA_URL o painel usa o provedor SIMULADO e nunca envia nada.

# Chave SECRETA do Supabase (Project Settings → API Keys → secret). O worker e o webhook
# rodam sem você logado e precisam dela. NUNCA vai para o navegador, git ou Vercel.
SUPABASE_SECRET_KEY=

# Senha do worker (`npm run worker`) e segredo do webhook do GOWA. Gere cada um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_TOKEN=
WA_WEBHOOK_SECRET=

# GOWA (WhatsApp em Go) rodando no PC. `npm run gowa` sobe ele na porta 3300.
GOWA_URL=
# usuario:senha que você inventa; o script do GOWA usa o mesmo valor em --basic-auth.
GOWA_BASIC_AUTH=
# (opcional) só se o GOWA tiver mais de um aparelho conectado.
GOWA_DEVICE_ID=

# ── Agente de atendimento (IA opcional) ──────────────────────────────────────
# Sem nenhuma chave o agente trabalha só com as regras do playbook (grátis, sem internet).
# Com chave, a IA reescreve/estende as respostas e a "trava" confere preço, prazo, link e Pix.
# Ordem de uso (AGENT_ORDER; padrão openai,gemini): o primeiro escreve; os seguintes só entram se o anterior
# FALHAR (erro, limite, sem internet). Uma chave que bate o limite descansa 1 minuto.

# OpenAI: uma ou mais chaves (OPENAI_API_KEY, OPENAI_API_KEY_2... até _6, ou várias separadas por vírgula).
# Só é usada com OPENAI_MODEL preenchido (agente > "Testar a IA" lista os modelos da sua conta).
# Recomendado: gpt-6-luna (medido em 24/10/2026: ~US$ 0,00016 por resposta, ~2 s). Veja docs/AGENTE.md.
OPENAI_API_KEY=
OPENAI_MODEL=
# (opcional) esforço de raciocínio: none, minimal, low, medium, high, xhigh ou max. Vazio = o certo para o modelo
# (luna: none; sol e astra: low). Raciocinar mais custa mais e demora mais, e uma resposta de WhatsApp não precisa.
OPENAI_REASONING=

# Google Gemini: uma ou mais chaves (GEMINI_API_KEY, GEMINI_API_KEY_2... até _6, ou várias separadas por vírgula).
# Grátis em aistudio.google.com/apikey. ATENÇÃO: no plano grátis o Google pode usar o conteúdo que receber para
# melhorar os produtos dele. O limite do plano grátis é por PROJETO do Google: chaves do mesmo projeto dividem
# o mesmo limite.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
# (opcional) modelo do Gemini; padrão gemini-3.8-flash.
AGENT_MODEL=

# (opcional) quem escreve primeiro: "openai,gemini" (padrão) ou "gemini,openai".
AGENT_ORDER=
# (opcional) "off" desliga a IA mesmo com as chaves preenchidas.
AGENT_PROVIDER=
# (opcional) "manual": os rascunhos de resposta nascem pelas regras (nada sai do PC) e a IA só entra quando você
# clica em "Pedir resposta ao agente". Vazio ou "auto": a IA escreve todo rascunho de resposta.
AGENT_AI_MODE=
