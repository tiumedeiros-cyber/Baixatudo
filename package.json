{
  "name": "baixatudo-studio",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run build && node --use-system-ca server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/app.js && node --check src/core.js && node --check src/ai-client.js && node --check src/providers.js && node --check extension/popup.js && node --check api/infer.js && node --check engine/lib/providers.js && node --check src/accounts.js && node --check api/config.js && node --check src/admin.js && node --check src/visual-editor.js && node --check engine/lib/platform-access.js",
    "test:browser": "node tests/browser.mjs",
    "package": "node scripts/package.mjs",
    "build": "node scripts/build.mjs",
    "test:accounts": "node tests/accounts-browser.mjs",
    "test:extension": "node tests/extension-browser.mjs",
    "verify": "node scripts/verify.mjs",
    "release:check": "node scripts/verify.mjs --release",
    "test:capture:live": "node tests/capture-live.mjs",
    "pretest": "npm run build",
    "security": "npm audit --audit-level=moderate",
    "test:visual": "node tests/visual-browser.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sparticuz/chromium": "^153.0.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.87",
    "@supabase/supabase-js": "^2.119.0",
    "cheerio": "^1.2.0",
    "ipaddr.js": "^2.5.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
