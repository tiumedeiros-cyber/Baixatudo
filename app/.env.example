# ─────────────────────────── Navalha · variáveis de ambiente ───────────────────────────
# Copie para .env e ajuste. O servidor lê estas chaves no boot.

# Servidor
PORT=3000
NODE_ENV=development
JWT_SECRET=troque-este-segredo-em-producao
DATA_DIR=./server/data
# DB_PATH=./server/data/navalha.db   # opcional, sobrepõe DATA_DIR
NOTIFY_LOG=true                      # logs de "outbox" das notificações

# Pagamentos (gateway interno simulado por padrão)
PAYMENT_GATEWAY=navalha-pay
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
# PAGSEGURO_TOKEN=...

# Comunicação
# SENDGRID_API_KEY=SG....
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+15551234567
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...

# OAuth social
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# FACEBOOK_APP_ID=...
# FACEBOOK_APP_SECRET=...

# Observabilidade
# SENTRY_DSN=https://...
